{
  "name": "inflow-despesas-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "inflow_user",
    "database.password": "inflow_pass",
    "database.dbname": "inflow_db",
    "topic.prefix": "inflow",
    "schema.include.list": "oltp",
    "table.include.list": "oltp.despesas",
    "plugin.name": "pgoutput",
    "publication.name": "inflow_despesas_pub",
    "publication.autocreate.mode": "disabled",
    "slot.name": "inflow_despesas_slot",
    "tombstones.on.delete": "false",
    "decimal.handling.mode": "string"
  }
}
