
# Configurações do Banco de Dados PostgreSQL (OLTP)
POSTGRES_DB=inflow_db
POSTGRES_USER=inflow_user
POSTGRES_PASSWORD=inflow_pass
POSTGRES_PORT=5433

# Parâmetros do Ingestor
INGESTION_YEAR=2024
LIMIT_SENADORES=0 # 0 para processar todos os senadores

# Sócios e empresas dos fornecedores (dados abertos do CNPJ da Receita Federal)
# 1 baixa ~2,1 GB na primeira execução de cada mês (~11 min); 0 desativa o job
ENABLE_CNPJ_OWNERS=1
# Token do compartilhamento público da RFB: código após /index.php/s/ na URL da
# pasta Dados > Cadastros > CNPJ em https://arquivos.receitafederal.gov.br
RFB_CNPJ_TOKEN=gn672Ad4CF8N6TK
# Mês do retrato (AAAA-MM); vazio usa o mais recente completo
RFB_CNPJ_MONTH=
# Quantos níveis de empresas sócias subir a partir do fornecedor para achar o dono final
CNPJ_OWNER_MAX_DEPTH=5
