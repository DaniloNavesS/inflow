
# Configurações do Banco de Dados PostgreSQL (OLTP)
POSTGRES_DB=inflow_db
POSTGRES_USER=inflow_user
POSTGRES_PASSWORD=inflow_pass
POSTGRES_PORT=5433

# MariaDB usado pela comparação de bancos (`make benchmark`)
MARIADB_DATABASE=benchmark
MARIADB_USER=inflow_user
MARIADB_PASSWORD=inflow_pass
MARIADB_ROOT_PASSWORD=inflow_root_pass
MARIADB_PORT=3307

# Parâmetros do Ingestor
INGESTION_YEAR=2024
LIMIT_SENADORES=0 # 0 para processar todos os senadores
